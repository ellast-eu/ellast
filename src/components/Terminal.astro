---
import { getCollection } from 'astro:content';
import { getRepos } from '../lib/github';
import { SITE } from '../site.config';

const { repos } = await getRepos();
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const data = {
  user: SITE.githubUser,
  author: SITE.author,
  links: SITE.links,
  repos: repos.map((r) => ({
    name: r.name,
    description: r.description,
    url: r.url,
    homepage: r.homepage,
    language: r.language,
    stars: r.stars,
    archived: r.archived,
    updatedAt: r.updatedAt,
  })),
  posts: posts.map((p) => ({
    slug: p.id,
    title: p.data.title,
    date: p.data.date.toISOString().slice(0, 10),
    description: p.data.description,
  })),
};
// Échappe "<" pour qu'aucun contenu ne puisse fermer la balise <script>
const json = JSON.stringify(data).replace(/</g, '\\u003c');
---

<section class="terminal" aria-label="Terminal interactif">
  <div class="terminal__barre">
    <span class="terminal__titre">stella@ellast: ~</span>
    <span class="terminal__tension" aria-hidden="true">
      <span class="terminal__voyant"></span>20 kV
    </span>
  </div>
  <div class="terminal__ecran" id="term-ecran">
    <div class="terminal__journal" id="term-journal" role="log" aria-live="polite"></div>
    <form class="terminal__ligne" id="term-form" autocomplete="off">
      <label for="term-saisie" class="terminal__invite">
        <span class="i-user">stella@ellast</span><span class="i-sep">:</span><span class="i-dir" id="term-dir">~</span><span class="i-dollar">$</span>
        <span class="sr-only">Commande</span>
      </label>
      <span class="terminal__champ">
        <input
          id="term-saisie"
          class="terminal__saisie"
          type="text"
          spellcheck="false"
          autocapitalize="off"
          enterkeyhint="send"
          aria-describedby="term-aide"
        />
        <span class="terminal__curseur" id="term-curseur" aria-hidden="true"></span>
      </span>
    </form>
  </div>
  <p class="terminal__aide" id="term-aide">
    Tape <kbd>help</kbd> pour la liste des commandes. <kbd>Tab</kbd> complète, <kbd>↑</kbd> rappelle l'historique.
  </p>
</section>

<script type="application/json" id="term-data" is:inline set:html={json} />

<script>
  type Repo = {
    name: string; description: string; url: string; homepage: string | null;
    language: string | null; stars: number; archived: boolean; updatedAt: string;
  };
  type Post = { slug: string; title: string; date: string; description: string };
  type Data = {
    user: string; author: string;
    links: { github: string; email: string; linkedin: string };
    repos: Repo[]; posts: Post[];
  };

  const data: Data = JSON.parse(document.getElementById('term-data')!.textContent || '{}');
  const journal = document.getElementById('term-journal')!;
  const ecran = document.getElementById('term-ecran')!;
  const form = document.getElementById('term-form') as HTMLFormElement;
  const saisie = document.getElementById('term-saisie') as HTMLInputElement;
  const reduit = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- Rendu : uniquement via textContent / createElement, jamais innerHTML ---
  type Seg = string | { t: string; c?: string; href?: string };
  // Chaque ligne de sortie arrive un peu après la précédente, comme un affichage qui défile
  let rang = 0;
  const ligne = (segs: Seg[] | string, cls = '') => {
    const el = document.createElement('div');
    el.className = 'l l--sortie ' + cls;
    el.style.setProperty('--i', String(Math.min(rang++, 30)));
    for (const s of typeof segs === 'string' ? [segs] : segs) {
      if (typeof s === 'string') { el.append(s); continue; }
      const n = document.createElement(s.href ? 'a' : 'span');
      if (s.href) {
        (n as HTMLAnchorElement).href = s.href;
        if (/^https?:/.test(s.href)) { (n as HTMLAnchorElement).rel = 'noopener noreferrer'; }
      }
      if (s.c) n.className = s.c;
      n.textContent = s.t;
      el.append(n);
    }
    journal.append(el);
    return el;
  };
  const vide = () => ligne(' ');
  const defile = () => { ecran.scrollTop = ecran.scrollHeight; };

  const findRepo = (q: string) =>
    data.repos.find((r) => r.name.toLowerCase() === q.toLowerCase());
  const findPost = (q: string) =>
    data.posts.find((p) => p.slug === q || p.slug.endsWith('/' + q));

  const vers = (href: string) => {
    ligne([{ t: '→ ', c: 'c-violet' }, 'ouverture de ', { t: href, c: 'c-ambre' }]);
    setTimeout(() => { window.location.href = href; }, reduit ? 0 : 350);
  };

  // --- Système de fichiers fictif, pour ls / cd / cat ---
  const dossiers: Record<string, () => string[]> = {
    '~': () => ['projets/', 'blog/', 'a-propos.txt', 'contact.txt'],
    projets: () => data.repos.map((r) => r.name),
    blog: () => data.posts.map((p) => p.slug + '.md'),
  };
  let cwd = '~';
  const dirEl = document.getElementById('term-dir')!;

  const aPropos = () => {
    ligne([{ t: data.author, c: 'c-encre fort' }]);
    ligne('Sécurité des intervenants à proximité des réseaux HTA/BT chez Enedis.');
    ligne("En reconversion vers l'administration système (MCO/MCS),");
    ligne('avec une équipe cyber en ligne de mire.');
    ligne('Consultante indépendante (SC2) : impression 3D et conseil cyber.');
    vide();
    ligne(['Plus de détails : ', { t: '/a-propos/', href: '/a-propos/' }]);
  };

  const contact = () => {
    ligne(['github    ', { t: data.links.github, href: data.links.github }]);
    if (data.links.email) ligne(['courriel  ', { t: data.links.email, href: 'mailto:' + data.links.email }]);
    if (data.links.linkedin) ligne(['linkedin  ', { t: data.links.linkedin, href: data.links.linkedin }]);
  };

  const listeProjets = () => {
    if (!data.repos.length) {
      ligne('Aucun dépôt chargé. La liste complète est sur GitHub :', 'c-brume');
      ligne([{ t: data.links.github, href: data.links.github }]);
      return;
    }
    const w = Math.max(...data.repos.map((r) => r.name.length)) + 2;
    for (const r of data.repos) {
      ligne([
        { t: r.archived ? '○ ' : '● ', c: r.archived ? 'c-brume' : 'c-ambre' },
        { t: r.name.padEnd(w), c: 'c-violet' },
        { t: (r.language ?? '—').padEnd(12), c: 'c-brume' },
        r.description ? r.description.slice(0, 60) + (r.description.length > 60 ? '…' : '') : '',
      ]);
    }
    vide();
    ligne([{ t: '● ', c: 'c-ambre' }, { t: 'sous tension   ', c: 'c-brume' }, { t: '○ archivé   ', c: 'c-brume' }, 'cat <projet> pour le détail']);
  };

  const ficheProjet = (r: Repo) => {
    ligne([{ t: r.name, c: 'c-violet fort' }, r.archived ? '  (archivé)' : '']);
    if (r.description) ligne(r.description);
    ligne([
      { t: 'langage ', c: 'c-brume' }, r.language ?? '—',
      { t: '   ★ ', c: 'c-ambre' }, String(r.stars),
      { t: '   maj ', c: 'c-brume' }, r.updatedAt.slice(0, 10),
    ]);
    ligne(['dépôt   ', { t: r.url, href: r.url }]);
    if (r.homepage) ligne(['démo    ', { t: r.homepage, href: r.homepage }]);
  };

  const listeBlog = () => {
    if (!data.posts.length) { ligne('Aucun article publié pour le moment.', 'c-brume'); return; }
    for (const p of data.posts) {
      ligne([{ t: p.date + '  ', c: 'c-brume' }, { t: p.title, href: `/blog/${p.slug}/` }]);
    }
  };

  const neofetch = () => {
    const art = [
      '    ╷   ',
      '  ──┼── ',
      '   ╱ ╲  ',
      '  ╱ ╳ ╲ ',
      ' ╱ ╱ ╲ ╲',
      '╱ ╱   ╲ ╲',
    ];
    const info: Seg[][] = [
      [{ t: 'stella', c: 'c-violet fort' }, '@', { t: 'ellast', c: 'c-violet fort' }],
      ['───────────────'],
      [{ t: 'OS       ', c: 'c-ambre' }, 'Qubes, par compartiments'],
      [{ t: 'Réseau   ', c: 'c-ambre' }, 'HTA 20 kV / BT 400 V'],
      [{ t: 'Shell    ', c: 'c-ambre' }, 'ellsh 0.1'],
      [{ t: 'Dépôts   ', c: 'c-ambre' }, String(data.repos.length)],
      [{ t: 'Articles ', c: 'c-ambre' }, String(data.posts.length)],
    ];
    for (let i = 0; i < Math.max(art.length, info.length); i++) {
      ligne([{ t: (art[i] ?? '').padEnd(12), c: 'c-violet' }, ...(info[i] ?? [])]);
    }
  };

  const historique: string[] = [];
  let curseurHist = 0;

  const commandes: Record<string, { aide: string; run: (args: string[]) => void }> = {
    help: {
      aide: 'cette aide',
      run: () => {
        for (const [nom, c] of Object.entries(commandes)) {
          if (c.aide) ligne([{ t: nom.padEnd(16), c: 'c-violet' }, { t: c.aide, c: 'c-brume' }]);
        }
      },
    },
    whoami: { aide: 'qui tient ce poste', run: aPropos },
    ls: {
      aide: 'lister le dossier courant ou [projets|blog]',
      run: ([d]) => {
        const cible = (d ?? cwd).replace(/\/$/, '').replace(/^~\//, '');
        const f = dossiers[cible];
        if (!f) { ligne(`ls: ${d} : aucun dossier de ce nom`, 'c-rouge'); return; }
        const items = f();
        if (cible === 'projets') { listeProjets(); return; }
        if (cible === 'blog') { listeBlog(); return; }
        ligne(items.map((n) => ({ t: n + '   ', c: n.endsWith('/') ? 'c-violet' : '' })));
      },
    },
    cd: {
      aide: 'changer de dossier (projets, blog, ~)',
      run: ([d = '~']) => {
        const cible = d.replace(/\/$/, '').replace(/^~\//, '');
        if (cible === '..' || cible === '~' || cible === '/') { cwd = '~'; }
        else if (dossiers[cible] && cible !== '~') { cwd = cible; }
        else { ligne(`cd: ${d} : aucun dossier de ce nom`, 'c-rouge'); return; }
        dirEl.textContent = cwd === '~' ? '~' : '~/' + cwd;
      },
    },
    cat: {
      aide: 'afficher un fichier ou la fiche d\'un projet',
      run: ([f]) => {
        if (!f) { ligne('cat: quel fichier ?', 'c-rouge'); return; }
        const n = f.replace(/^projets\//, '').replace(/^blog\//, '');
        if (n === 'a-propos.txt') return aPropos();
        if (n === 'contact.txt') return contact();
        const r = findRepo(n);
        if (r) return ficheProjet(r);
        const p = findPost(n.replace(/\.md$/, ''));
        if (p) {
          ligne([{ t: p.title, c: 'c-violet fort' }]);
          ligne([{ t: p.date, c: 'c-brume' }]);
          ligne(p.description);
          ligne(['lire : ', { t: `/blog/${p.slug}/`, href: `/blog/${p.slug}/` }]);
          return;
        }
        ligne(`cat: ${f} : fichier introuvable`, 'c-rouge');
      },
    },
    projets: { aide: 'les dépôts GitHub', run: listeProjets },
    blog: { aide: 'les derniers articles', run: listeBlog },
    open: {
      aide: 'ouvrir un projet, un article, ou github',
      run: ([q]) => {
        if (!q) { ligne('open: quoi ?  open <projet> | open <article> | open github', 'c-rouge'); return; }
        if (q === 'github') return vers(data.links.github);
        const r = findRepo(q);
        if (r) return vers(r.url);
        const p = findPost(q.replace(/\.md$/, ''));
        if (p) return vers(`/blog/${p.slug}/`);
        ligne(`open: ${q} : rien de ce nom`, 'c-rouge');
      },
    },
    contact: { aide: 'me joindre', run: contact },
    neofetch: { aide: 'fiche système', run: neofetch },
    history: {
      aide: 'commandes déjà tapées',
      run: () => historique.forEach((h, i) => ligne([{ t: String(i + 1).padStart(4) + '  ', c: 'c-brume' }, h])),
    },
    date: { aide: '', run: () => ligne(new Date().toLocaleString('fr-FR')) },
    echo: { aide: '', run: (a) => ligne(a.join(' ')) },
    pwd: { aide: '', run: () => ligne(cwd === '~' ? '/home/stella' : '/home/stella/' + cwd) },
    sudo: {
      aide: '',
      run: () => ligne("stella n'est pas dans le fichier sudoers. Cet incident sera signalé.", 'c-rouge'),
    },
    rm: {
      aide: '',
      run: () => ligne("rm : consignation refusée. On ne travaille pas sur un ouvrage sans l'avoir mis hors tension.", 'c-ambre'),
    },
    exit: {
      aide: 'quitter le terminal pour la navigation classique',
      run: () => {
        ligne('Session fermée. Navigation classique :');
        ligne([
          { t: 'Projets', href: '/projets/' }, '   ',
          { t: 'Blog', href: '/blog/' }, '   ',
          { t: 'À propos', href: '/a-propos/' },
        ]);
      },
    },
    clear: { aide: 'effacer l\'écran', run: () => { journal.replaceChildren(); } },
  };
  commandes.ll = commandes.ls;
  commandes.about = commandes.whoami;

  const executer = (brut: string) => {
    const texte = brut.trim();
    rang = 0;
    ligne([
      { t: 'stella@ellast', c: 'i-user' }, { t: ':', c: 'i-sep' },
      { t: cwd === '~' ? '~' : '~/' + cwd, c: 'i-dir' }, { t: '$ ', c: 'i-dollar' }, texte,
    ], 'l--cmd');
    if (!texte) return;
    historique.push(texte);
    curseurHist = historique.length;
    const [nom, ...args] = texte.split(/\s+/);
    const c = commandes[nom.toLowerCase()];
    if (c) c.run(args);
    else ligne([`${nom} : commande introuvable. Essaie `, { t: 'help', c: 'c-violet' }, '.'], 'c-brume');
  };

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    executer(saisie.value);
    saisie.value = '';
    placerCurseur();
    defile();
  });

  // Historique et complétion
  saisie.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (curseurHist > 0) saisie.value = historique[--curseurHist];
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (curseurHist < historique.length - 1) saisie.value = historique[++curseurHist];
      else { curseurHist = historique.length; saisie.value = ''; }
    } else if (e.key === 'Tab') {
      const v = saisie.value;
      const parts = v.split(/\s+/);
      const avecArg = parts.length > 1;
      const pool = avecArg
        ? [...data.repos.map((r) => r.name), ...data.posts.map((p) => p.slug), 'projets', 'blog', 'github', 'a-propos.txt', 'contact.txt']
        : Object.keys(commandes);
      const prefixe = parts[parts.length - 1].toLowerCase();
      if (!prefixe && !avecArg) return; // laisse Tab sortir du champ si rien n'est tapé
      e.preventDefault();
      const candidats = pool.filter((p) => p.toLowerCase().startsWith(prefixe));
      if (candidats.length === 1) {
        parts[parts.length - 1] = candidats[0];
        saisie.value = parts.join(' ') + ' ';
      } else if (candidats.length > 1) {
        ligne(candidats.join('   '), 'c-brume');
        defile();
      }
    } else if (e.key === 'l' && e.ctrlKey) {
      e.preventDefault();
      journal.replaceChildren();
    }
  });

  // Curseur en bloc : placé à la position du caret (police à chasse fixe, donc 1ch par caractère)
  const curseur = document.getElementById('term-curseur')!;
  const placerCurseur = () => {
    const pos = saisie.selectionStart ?? saisie.value.length;
    const largeur = curseur.getBoundingClientRect().width || 8;
    curseur.style.setProperty('--pos', String(pos - saisie.scrollLeft / largeur));
    curseur.classList.remove('terminal__curseur--frappe');
    void curseur.offsetWidth; // relance l'animation : le curseur reste plein pendant la frappe
    curseur.classList.add('terminal__curseur--frappe');
  };
  ['input', 'keyup', 'click', 'select', 'focus'].forEach((ev) => saisie.addEventListener(ev, placerCurseur));
  saisie.addEventListener('focus', () => curseur.classList.add('terminal__curseur--actif'));
  saisie.addEventListener('blur', () => curseur.classList.remove('terminal__curseur--actif'));

  // Un clic dans l'écran redonne le focus à la saisie (sauf sélection de texte ou lien)
  ecran.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) return;
    if (window.getSelection()?.toString()) return;
    saisie.focus({ preventScroll: true });
  });

  // --- Mise sous tension ---
  const sequence: [string, string][] = [
    ['ok', 'Vérification d\'absence de tension'],
    ['ok', 'Levée de consignation du départ D-01'],
    ['ok', `Fermeture du disjoncteur, ${data.repos.length} départ(s) projets`],
    ['ok', `Montage de /blog, ${data.posts.length} article(s)`],
    ['ok', 'Ouverture du shell ellsh'],
  ];

  const accueil = () => {
    vide();
    ligne([{ t: 'Bienvenue sur ellast.', c: 'c-encre fort' }, " Le poste de Stella : réseaux électriques et cybersécurité."]);
    ligne(['Commence par ', { t: 'whoami', c: 'c-violet' }, ', ', { t: 'projets', c: 'c-violet' }, ' ou ', { t: 'help', c: 'c-violet' }, '.']);
    vide();
  };

  const dejaVu = (() => { try { return sessionStorage.getItem('ellast-boot') === '1'; } catch { return false; } })();

  const demarrer = async () => {
    if (reduit || dejaVu) {
      for (const [, t] of sequence) ligne([{ t: '[  OK  ] ', c: 'c-ambre' }, t]);
    } else {
      await new Promise((r) => setTimeout(r, 650)); // le temps que l'écran s'allume
      let interrompu = false;
      const stop = () => { interrompu = true; };
      window.addEventListener('keydown', stop, { once: true });
      for (const [, t] of sequence) {
        rang = 0;
        ligne([{ t: '[  OK  ] ', c: 'c-ambre' }, t], 'l--boot');
        if (!interrompu) await new Promise((r) => setTimeout(r, 260));
      }
      window.removeEventListener('keydown', stop);
      try { sessionStorage.setItem('ellast-boot', '1'); } catch { /* stockage indisponible */ }
    }
    rang = 0;
    accueil();
    defile();
    // Pas de focus automatique sur mobile : le clavier virtuel masquerait l'écran
    if (window.matchMedia('(pointer: fine)').matches) saisie.focus({ preventScroll: true });
  };

  demarrer();
</script>

<style is:global>
  .terminal {
    /* Le terminal a sa propre palette violette : on redéfinit les teintes neutres */
    --brume: var(--t-brume);
    --ligne: var(--t-bord);
    --t-pad: clamp(14px, 2.5vw, 26px);
    position: relative; /* contient le libellé sr-only et les effets d'écran */
    isolation: isolate;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
    border: 1px solid var(--t-bord);
    border-radius: 12px;
    background:
      radial-gradient(120% 90% at 85% -10%, var(--t-fond-2) 0%, transparent 60%),
      radial-gradient(80% 60% at 0% 110%, #241046 0%, transparent 70%),
      var(--t-fond);
    box-shadow:
      0 0 0 1px rgb(179 140 255 / 0.08),
      0 30px 90px -30px rgb(143 92 255 / 0.55),
      inset 0 1px 0 rgb(255 255 255 / 0.04);
    overflow: hidden;
    font-family: var(--mono);
    font-size: clamp(0.74rem, 0.68rem + 0.3vw, 0.86rem);
    line-height: 1.65;
    animation: allumage 0.75s cubic-bezier(.2,.8,.2,1) both;
  }
  /* Mise sous tension façon écran cathodique : un trait, puis l'image */
  @keyframes allumage {
    0%   { clip-path: inset(49.6% 50% 49.6% 50% round 12px); filter: brightness(2.2); }
    40%  { clip-path: inset(49.6% 0 49.6% 0 round 12px); filter: brightness(2.2); }
    100% { clip-path: inset(0 0 0 0 round 12px); filter: none; }
  }
  /* Lignes de balayage fixes, et une bande lumineuse qui descend lentement */
  .terminal::before,
  .terminal::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 2;
  }
  .terminal::before {
    background: repeating-linear-gradient(to bottom, transparent 0 2px, rgb(0 0 0 / 0.14) 2px 3px);
    mix-blend-mode: multiply;
  }
  .terminal::after {
    background: linear-gradient(to bottom, transparent, rgb(179 140 255 / 0.06) 50%, transparent);
    height: 30%;
    animation: balayage 7s linear infinite;
  }
  @keyframes balayage { from { transform: translateY(-100%); } to { transform: translateY(440%); } }

  .terminal__barre {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.55rem var(--t-pad);
    border-bottom: 1px solid var(--t-bord);
    background: rgb(0 0 0 / 0.18);
    color: var(--brume);
    font-size: 0.78em;
  }
  .terminal__tension { display: inline-flex; align-items: center; gap: 0.5em; color: var(--ambre); }
  .terminal__voyant {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--ambre);
    box-shadow: 0 0 8px var(--ambre);
    animation: respire 2.4s ease-in-out infinite;
  }
  @keyframes respire { 50% { opacity: 0.45; box-shadow: 0 0 2px var(--ambre); } }

  .terminal__ecran {
    position: relative;
    z-index: 1;
    flex: 1;
    overflow-y: auto;
    padding: var(--t-pad);
    cursor: text;
    scrollbar-color: var(--t-bord) transparent;
    text-shadow: 0 0 6px rgb(179 140 255 / 0.28);
  }
  .terminal__journal .l { white-space: pre-wrap; word-break: break-word; min-height: 1.65em; }
  .terminal__journal a { color: var(--violet); text-decoration-color: rgb(179 140 255 / 0.5); }
  .terminal__journal a:hover { color: var(--encre); text-decoration-color: currentColor; }
  .l--cmd { margin-top: 0.35em; }
  .l--sortie {
    animation: ligne-in 0.22s ease-out both;
    animation-delay: calc(var(--i, 0) * 16ms);
  }
  @keyframes ligne-in { from { opacity: 0; transform: translateX(-6px); } }
  .l--boot { animation: allume 0.3s steps(3) both; }
