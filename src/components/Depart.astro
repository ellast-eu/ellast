---
// Un « départ » du schéma unifilaire : une ligne qui part du jeu de barres,
// un organe de coupure (fermé = actif, ouvert = archivé), puis la fiche du dépôt.
import type { Repo } from '../lib/github';
import { formatDate } from '../lib/github';

interface Props { repo: Repo }
const { repo } = Astro.props;
const ferme = !repo.archived;
---

<li class:list={['depart', { 'depart--vedette': repo.featured, 'depart--ouvert': !ferme }]}>
  <svg class="depart__organe" viewBox="0 0 64 24" aria-hidden="true">
    <line x1="0" y1="12" x2="22" y2="12" />
    {ferme ? (
      <>
        <rect x="22" y="4" width="16" height="16" class="plein" />
        <line x1="38" y1="12" x2="64" y2="12" />
      </>
    ) : (
      <>
        <circle cx="24" cy="12" r="2.2" class="plein" />
        <line x1="24" y1="12" x2="40" y2="2" />
        <circle cx="42" cy="12" r="2.2" class="plein" />
        <line x1="42" y1="12" x2="64" y2="12" class="mort" />
      </>
    )}
  </svg>

  <div class="depart__fiche">
    <h2 class="depart__nom">
      <a href={repo.url} rel="noopener noreferrer">{repo.name}</a>
    </h2>
    {repo.description && <p class="depart__desc">{repo.description}</p>}
    <p class="depart__meta">
      <span>{ferme ? 'Actif' : 'Archivé'}</span>
      {repo.language && <span>{repo.language}</span>}
      {repo.stars > 0 && <span>★ {repo.stars}</span>}
      <span>mis à jour le <time datetime={repo.updatedAt}>{formatDate(repo.updatedAt)}</time></span>
      {repo.homepage && <a href={repo.homepage} rel="noopener noreferrer">Voir la démo</a>}
    </p>
    {repo.topics.length > 0 && (
      <ul class="depart__sujets" aria-label="Sujets">
        {repo.topics.map((t) => <li>{t}</li>)}
      </ul>
    )}
  </div>
</li>

<style>
  .depart {
    position: relative;
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 1.1rem;
    align-items: start;
    padding: 1.1rem 0;
  }
  .depart__organe {
    width: 64px;
    height: 24px;
    margin-top: 0.15rem;
    stroke: var(--violet);
    stroke-width: 2;
    fill: none;
    overflow: visible;
  }
  .depart__organe .plein { fill: var(--ambre); stroke: var(--ambre); }
  .depart--ouvert .depart__organe { stroke: var(--brume); }
  .depart--ouvert .depart__organe .plein { fill: var(--nuit); stroke: var(--brume); }
  .depart__organe .mort { stroke-dasharray: 3 4; }

  .depart__fiche { min-width: 0; }
  .depart__nom {
    font-size: 1.05rem;
    margin: 0 0 0.3rem;
    word-break: break-word;
  }
  .depart__nom a { color: var(--encre); text-decoration: none; }
  .depart__nom a:hover { color: var(--violet); text-decoration: underline; }
  .depart--vedette .depart__nom { font-size: 1.4rem; }
  .depart--ouvert .depart__nom a { color: var(--brume); }

  .depart__desc { margin: 0 0 0.45rem; max-width: 62ch; }
  .depart__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.2rem;
    margin: 0;
    color: var(--brume);
    font-size: 0.88rem;
  }
  .depart__meta > span:first-child { color: var(--ambre); }
  .depart--ouvert .depart__meta > span:first-child { color: var(--brume); }

  .depart__sujets {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0.6rem 0 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.72rem;
  }
  .depart__sujets li {
    color: var(--violet);
    border: 1px solid var(--ligne);
    border-radius: 999px;
    padding: 0.05rem 0.6rem;
  }
  /* Mise sous tension du schéma : le jeu de barres se trace, puis chaque départ
     s'enclenche à son tour (délai calculé depuis sa position dans la liste). */
  .depart:nth-child(1) { --n: 0; }
  .depart:nth-child(2) { --n: 1; }
  .depart:nth-child(3) { --n: 2; }
  .depart:nth-child(4) { --n: 3; }
  .depart:nth-child(5) { --n: 4; }
  .depart:nth-child(6) { --n: 5; }
  .depart:nth-child(7) { --n: 6; }
  .depart:nth-child(8) { --n: 7; }
  .depart:nth-child(9) { --n: 8; }
  .depart:nth-child(10) { --n: 9; }
  .depart:nth-child(11) { --n: 10; }
  .depart:nth-child(12) { --n: 11; }
  .depart:nth-child(13) { --n: 12; }
  .depart:nth-child(14) { --n: 13; }
  .depart:nth-child(15) { --n: 14; }
  .depart:nth-child(16) { --n: 15; }
  .depart:nth-child(17) { --n: 16; }
  .depart:nth-child(18) { --n: 17; }
  .depart:nth-child(19) { --n: 18; }
  .depart:nth-child(20) { --n: 19; }
  .depart:nth-child(21) { --n: 20; }
  .depart:nth-child(22) { --n: 21; }
  .depart:nth-child(23) { --n: 22; }
  .depart:nth-child(24) { --n: 23; }
  .depart { --t0: calc(0.45s + var(--n, 0) * 0.12s); }
  .depart__organe line {
    stroke-dasharray: 64;
    stroke-dashoffset: 64;
    animation: trace 0.35s ease-out both;
    animation-delay: var(--t0);
  }
  .depart__organe .plein {
    animation: enclenche 0.5s steps(1) both, lueur 0.6s ease-out both;
    animation-delay: calc(var(--t0) + 0.2s);
  }
  .depart--ouvert .depart__organe .plein { animation: none; }
  .depart__fiche {
    animation: fiche-in 0.45s cubic-bezier(.2,.7,.2,1) both;
    animation-delay: calc(var(--t0) + 0.1s);
  }
  @keyframes trace { to { stroke-dashoffset: 0; } }
  @keyframes enclenche { 0% { fill: transparent; } 40% { fill: var(--ambre); } }
  @keyframes lueur { 0% { filter: drop-shadow(0 0 0 var(--ambre)); } 50% { filter: drop-shadow(0 0 8px var(--ambre)); } }
  @keyframes fiche-in { from { opacity: 0; transform: translateX(-10px); } }

  /* Au survol, le départ « conduit » : la ligne s'éclaire */
  .depart__organe { transition: filter 0.25s; }
  .depart:hover .depart__organe,
  .depart:focus-within .depart__organe { filter: drop-shadow(0 0 6px var(--violet)); }
  .depart--ouvert:hover .depart__organe { filter: none; }
</style>
