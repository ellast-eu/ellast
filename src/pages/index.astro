---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
---

<Base bare>
  <div class="accueil">
    <p class="accueil__intro">
      <strong>Stella Caltagirone.</strong> Sécurité des réseaux électriques HTA/BT, en route vers la cybersécurité.
      <span class="accueil__alt">
        Pas d'humeur pour un terminal ? <a href="/projets/">Voir les projets</a> ou <a href="/blog/">lire le blog</a>.
      </span>
    </p>
    <Terminal />
  </div>
</Base>

<style>
  .accueil {
    flex: 1 1 0;
    min-height: 0; /* le terminal défile, pas la page */
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
    max-width: calc(78rem + 2 * var(--gouttiere));
    margin: 0 auto;
    padding: 1.4rem var(--gouttiere) var(--gouttiere);
  }
  .accueil__intro { margin: 0; color: var(--brume); max-width: 80ch; }
  .accueil__intro strong { color: var(--encre); font-weight: 600; }
  .accueil__alt { display: block; font-size: 0.92rem; }
</style>
