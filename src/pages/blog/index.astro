---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/github';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Blog" description="Write-ups de CTF, notes d'infrastructure et retours d'expérience.">
  <div class="page">
    <h1>Blog</h1>
    <p class="chapo">Write-ups de CTF, notes d'infrastructure, et ce que la sécurité électrique apprend à la sécurité informatique.</p>

    {posts.length ? (
      <ol class="articles" reversed>
        {posts.map((p) => (
          <li>
            <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
            <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ol>
    ) : (
      <p>Aucun article pour l'instant. Le premier arrive bientôt.</p>
    )}
  </div>
</Base>

<style>
  .articles { list-style: none; margin: 2.4rem 0 0; padding: 0; }
  .articles li { padding: 1.4rem 0; border-top: 1px solid var(--ligne); }
  .articles time { font-size: 0.85rem; color: var(--brume); }
  .articles h2 { margin: 0.25rem 0 0.4rem; font-size: 1.25rem; }
  .articles h2 a { color: var(--encre); text-decoration: none; }
  .articles h2 a:hover { color: var(--violet); text-decoration: underline; }
  .articles p { margin: 0; color: var(--brume); }
</style>
